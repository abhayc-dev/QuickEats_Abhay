EXPO_PUBLIC_API_URL=https://abhay-food-delivery.onrender.com

# Firebase Console -> Authentication -> Sign-in method -> Google ->
# "Web SDK configuration" client ID. Required for the Google Sign-In button.
# Google Sign-In also needs a custom dev build (`npx expo run:android` /
# `run:ios`) — it cannot run inside Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
