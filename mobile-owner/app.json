{
  "expo": {
    "name": "ChakiyaEats Partner",
    "slug": "chakiyaeats-owner",
    "scheme": "chakiyaeatsowner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chakiyaeats.owner"
    },
    "android": {
      "package": "com.chakiyaeats.owner",
      "adaptiveIcon": {
        "backgroundColor": "#FFF4EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "ChakiyaEats Partner needs access to your photos to upload shop and menu item images."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/chakiya-eats-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-audio"
    ]
  }
}
